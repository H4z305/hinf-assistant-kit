# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is gitignored — never commit it.
# ---------------------------------------------------------------------------

# Telegram bot token. Get it from @BotFather:
#   1. Open Telegram, search @BotFather, press Start.
#   2. Send /newbot. Give it a name, then a username ending in "bot".
#   3. BotFather replies with a token like 123456789:AAH...  — paste it here.
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user ID — the bridge rejects every message from any
# other ID. Two ways to get it:
#   a) Message @userinfobot on Telegram; it replies with your numeric Id.
#   b) Leave this blank, start the bridge (`node bot.js`), send your bot any
#      message, then look in bot.log — it logs the sender id of the rejected
#      message. Copy that number here and restart.
OWNER_TELEGRAM_ID=

# Absolute path to your project directory — the folder that holds your CLAUDE.md.
# REQUIRED. The bridge runs `claude` here so your persona loads. Forward slashes
# are fine on Windows. Example: C:/my-assistant
CLAUDE_CWD=

# Absolute path to your second-brain vault. Optional — defaults to
# <CLAUDE_CWD>/second-brain. Used by /hot and /log without invoking Claude.
VAULT_PATH=

# 'claude' on PATH is the default. Override only if it isn't on PATH.
CLAUDE_EXECUTABLE_PATH=

# Permission posture for every headless `claude` run this bridge makes.
#   acceptEdits       — Claude applies file edits but still asks before other
#                       sensitive actions. This is the safe default. START HERE.
#   bypassPermissions — Claude runs with NO permission prompts at all. Powerful
#                       and convenient, and a real risk if your bot token leaks
#                       or the owner lock is misconfigured. Only switch to this
#                       once you understand the bridge and have tested that a
#                       message from another Telegram account is rejected.
#                       The person whose setup this kit is based on chose this
#                       deliberately for their own machine — that is a decision
#                       to make, not a default to inherit.
# Unknown values are rejected at startup.
PERMISSION_MODE=acceptEdits

# Optional override for the proactive check-in / morning brief prompt.
PROACTIVE_CHECKIN_PROMPT=
